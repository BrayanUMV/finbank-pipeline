{
  "name": "finbank-pipeline-diario",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "America/Mexico_City",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": ["__EMAIL__"]
  },
  "parameters": [
    {"name": "batch_id", "default": "{{job.run_id}}"},
    {"name": "simular_error", "default": "no"}
  ],
  "job_clusters": [
    {
      "job_cluster_key": "c1",
      "new_cluster": {
        "spark_version": "__SPARK_VERSION__",
        "node_type_id": "__NODE_TYPE__",
        "num_workers": 0,
        "data_security_mode": "SINGLE_USER",
        "spark_conf": {
          "spark.databricks.cluster.profile": "singleNode",
          "spark.master": "local[*]"
        },
        "custom_tags": {"ResourceClass": "SingleNode"}
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "job_cluster_key": "c1",
      "max_retries": 3,
      "min_retry_interval_millis": 30000,
      "retry_on_timeout": true,
      "timeout_seconds": 1800,
      "notebook_task": {"notebook_path": "/Workspace/Users/__USER__/finbank/01_bronze"}
    },
    {
      "task_key": "silver",
      "job_cluster_key": "c1",
      "depends_on": [{"task_key": "bronze"}],
      "max_retries": 3,
      "min_retry_interval_millis": 30000,
      "retry_on_timeout": true,
      "timeout_seconds": 2400,
      "notebook_task": {"notebook_path": "/Workspace/Users/__USER__/finbank/02_silver"}
    },
    {
      "task_key": "gold",
      "job_cluster_key": "c1",
      "depends_on": [{"task_key": "silver"}],
      "max_retries": 3,
      "min_retry_interval_millis": 30000,
      "retry_on_timeout": true,
      "timeout_seconds": 2400,
      "notebook_task": {"notebook_path": "/Workspace/Users/__USER__/finbank/03_gold"}
    },
    {
      "task_key": "calidad",
      "job_cluster_key": "c1",
      "depends_on": [{"task_key": "gold"}],
      "max_retries": 3,
      "min_retry_interval_millis": 30000,
      "retry_on_timeout": true,
      "timeout_seconds": 1200,
      "notebook_task": {"notebook_path": "/Workspace/Users/__USER__/finbank/04_calidad"}
    },
    {
      "task_key": "resumen",
      "job_cluster_key": "c1",
      "depends_on": [{"task_key": "calidad"}],
      "max_retries": 3,
      "min_retry_interval_millis": 30000,
      "retry_on_timeout": true,
      "timeout_seconds": 600,
      "notebook_task": {"notebook_path": "/Workspace/Users/__USER__/finbank/05_resumen"}
    }
  ]
}
